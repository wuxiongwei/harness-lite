{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Harness-Lite settings.json · 团队共享配置（入版本库）",
  "_documentation": "https://github.com/zoe/harness-lite/blob/main/docs/03-customization/03-hooks.md",
  "_version": "{{HARNESS_LITE_VERSION}}",

  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(find * -name *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials.*)",
      "Edit(**/secrets.*)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa*)",
      "Edit(**/serviceAccountKey.json)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/credentials.*)",
      "Write(**/secrets.*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-test.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/versions/active/**/04-*.md)",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/distill-prompt.sh"
          }
        ]
      }
    ]
  },

  "_skill_config": {
    "default_path_router": "harness-req",
    "subagents": [
      "doc-generator",
      "reviewer",
      "implementer",
      "validator"
    ]
  }
}
